<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <!--
    net10.0: modern versions.
    - AutoMapper 13.0.1 targets net6.0+ and includes AddAutoMapper built-in (no extensions package needed).
    - MediatR 12.2.0 targets net6.0+ and includes DI registration built-in.
  -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="MediatR" Version="12.2.0" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <!--
    netstandard2.0: oldest netstandard2.0-compatible versions.
    - AutoMapper.Extensions.DI 8.0.1 is the last release targeting netstandard2.0 and
      requires AutoMapper [10.0.0, 11.0.0).
    - MediatR 8.1.0 + MediatR.Extensions.DI 8.1.0 target netstandard2.0.
    - System.Text.Json 9.0.5 supports netstandard2.0 (not a BCL type there).
    NOTE: AutoMapper 10.x has advisory GHSA-rvv3-g6hj-g44x; no netstandard2.0-compatible
    version of AutoMapper is free of this advisory. Recorded in summary.md.
  -->
  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <PackageReference Include="AutoMapper" Version="10.1.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="MediatR" Version="8.1.0" />
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="8.1.0" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Json" Version="9.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>
</Project>
