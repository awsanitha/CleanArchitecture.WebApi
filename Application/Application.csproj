<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <Version>1.1.0</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- AutoMapper 16.2.0 fixes GHSA-rvv3-g6hj-g44x and supports both net10.0 and netstandard2.0 with built-in DI -->
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="FluentValidation" Version="9.1.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="9.1.2" />
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="8.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- System.Text.Json and Encodings.Web: pin to safe versions compatible with AutoMapper 16.x transitive deps -->
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="System.Text.Encodings.Web" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>
</Project>
