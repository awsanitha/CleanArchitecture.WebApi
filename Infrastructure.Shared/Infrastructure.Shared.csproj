    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" Condition="'$(TargetFramework)'=='net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
  </ItemGroup>
</Project>
